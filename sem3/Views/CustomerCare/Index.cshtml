@{
    ViewBag.Title = "Customer Care";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/customer-care.css" rel="stylesheet" />

<div class="customer-care-container">
    <div class="care-header">
        <h1>Customer Care</h1>
        <p class="subtitle">@ViewBag.Subtitle</p>
    </div>

    <div class="emergency-contact">
        <div class="phone-card">
            <div class="phone-icon"><i class="fas fa-headset"></i></div>
            <h2>24/7 Customer Support</h2>
            <div class="phone-number"><i class="fas fa-phone"></i><span>@(ViewBag.Hotline ?? "1900 1000")</span></div>
            <p class="phone-description">Toll-free number available 24 hours a day, 7 days a week</p>
        </div>
    </div>

    <div class="support-options">
        <h3>Other Support Channels</h3>
        <div class="options-grid">
            <div class="option-card">
                <i class="fas fa-comments"></i>
                <h4>Live Chat</h4>
                <p>Instant messaging support with recharge assistant</p>
                <button class="option-btn" id="btnOpenChat">Start Chat</button>
            </div>
            <div class="option-card">
                <i class="fas fa-envelope"></i>
                <h4>Email Support</h4>
                <p>Send us your queries via email</p>
                <a href="@Url.Action("Index", "ContactUs")" class="option-btn">Send Email</a>
            </div>
            <div class="option-card">
                <i class="fas fa-question-circle"></i>
                <h4>FAQ</h4>
                <p>Find answers to common questions</p>
                <a href="#faq-section" class="option-btn">View FAQ</a>
            </div>
            <div class="option-card">
                <i class="fas fa-mobile-alt"></i>
                <h4>SMS Support</h4>
                <p>Text HELP to 8080 for assistance</p>
                <button class="option-btn">Send SMS</button>
            </div>
        </div>
    </div>
    <div class="common-issues" id="faq-section">
        <h3>Common Issues & Solutions</h3>

        <div id="faq-content-area">
            @Html.Action("GetFAQList", "CustomerCare", new { page = 1 })
        </div>

        <div id="faq-loading" style="display:none; text-align:center; padding: 20px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

@section myscript {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
            // 1. Logic Chatbox (Giữ nguyên)
            $('#btnOpenChat').click(function () {
                var chatIcon = $('.chat-btn-toggle');
                if (chatIcon.length > 0) chatIcon.click();
                else $('#chatbox-container button').click();
            });

            // 2. LOGIC AJAX PHÂN TRANG (Mới)
            $(document).on('click', '.ajax-link', function (e) {
                e.preventDefault(); // Chặn load lại trang

                var page = $(this).data('page'); // Lấy số trang cần đến
                var container = $('#faq-content-area');
                var loading = $('#faq-loading');

                // Hiệu ứng mờ đi và hiện loading
                container.css('opacity', '0.5');
                // loading.show(); // (Tuỳ chọn: hiện icon xoay)

                $.ajax({
                    url: '@Url.Action("GetFAQList", "CustomerCare")',
                    type: 'GET',
                    data: { page: page },
                    success: function (result) {
                        // Thay thế nội dung cũ bằng nội dung mới
                        container.html(result);
                        container.css('opacity', '1');
                        loading.hide();
                    },
                    error: function () {
                        alert('Error loading FAQs');
                        container.css('opacity', '1');
                        loading.hide();
                    }
                });
            });
        });
    </script>
}