@model List<sem3.Models.Entities.FAQ>

@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="issues-list">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="issue-item">
                <h4>@item.Question</h4>
                <p>@item.Answer</p>
            </div>
        }
    }
    else
    {
        <div class="issue-item" style="text-align:center; color:#666;">
            <p>No FAQs available at the moment.</p>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link ajax-link" href="#" data-page="@(currentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link ajax-link" href="#" data-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link ajax-link" href="#" data-page="@(currentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}