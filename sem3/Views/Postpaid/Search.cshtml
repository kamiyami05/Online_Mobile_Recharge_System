@{
    ViewBag.Title = "Postpaid Bill Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/postpaid.css" rel="stylesheet" />

<div class="content-wrapper">
    <div class="page-header">
        <h1>Postpaid Bill Payment</h1>
        <p>Search for your postpaid bills by mobile number</p>
    </div>

    <div class="form-container">
        <form method="get" action="/Postpaid/Index">
            <div class="form-group">
                <input type="text" name="mobile" class="form-control" placeholder="Enter mobile number" required maxlength="10">
            </div>

            <button type="submit" id="btnSubmit" class="btn btn-primary w-100">Search Bill</button>
        </form>
    </div>
</div>