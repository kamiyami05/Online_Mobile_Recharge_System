﻿@{
    ViewBag.Title = "Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/postpaid.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="page-header">
        <h1>Payment History</h1>
        <p>Search for your payment history by mobile number</p>
    </div>

    <div class="form-container">
        <form method="get" action="/Postpaid/History">
            <div class="form-group">
                <label class="form-label">Mobile Number</label>
                <input type="text" name="mobile" class="form-control" placeholder="Enter mobile number" required maxlength="10">
            </div>

            <button type="submit" class="btn btn-primary w-100">View History</button>
        </form>

        <a href="/Postpaid" class="btn btn-secondary w-100 mt-2">Back</a>
    </div>
</div>