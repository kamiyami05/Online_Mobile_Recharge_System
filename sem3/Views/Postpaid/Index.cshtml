﻿@model IEnumerable<sem3.Models.Entities.PostpaidBill>
@{
    ViewBag.Title = "Postpaid Bills";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/postpaid.css" rel="stylesheet" />

<div class="content-wrapper">
    <div class="page-header">
        <h1>Postpaid Bills</h1>
        <p>View and manage your postpaid bills</p>
    </div>
    <form>
        @if (!Model.Any())
        {
            <div class="alert alert-warning mt-3">
                No bills found for this mobile number.
            </div>
            <a href="/Postpaid" class="btn btn-secondary">Back</a>
        }
        else
        {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mobile Number</th>
                            <th>Billing Date</th>
                            <th>Total Amount</th>
                            <th>Payment Due</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MobileNumber</td>
                                <td>@item.BillingCycle.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>@String.Format("{0:0,0} VND", item.TotalAmount)</td>
                                <td>@(item.PaymentDueDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</td>
                                <td>
                                    @if (item.IsPaid.GetValueOrDefault())
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsPaid.GetValueOrDefault())
                                    {
                                        <a href="/Postpaid/Pay/@item.BillID" class="btn btn-primary btn-sm">Pay Now</a>
                                    }
                                    else
                                    {
                                        <a href="/Postpaid/Receipt/@item.PaymentTransactionID" class="btn btn-secondary btn-sm">View Receipt</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            <a href="/Postpaid" class="btn btn-secondary">Search Again</a>
        }
    </form>
</div>