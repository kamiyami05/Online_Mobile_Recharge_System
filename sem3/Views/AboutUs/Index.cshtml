﻿@{
    ViewBag.Title = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/about-us.css" rel="stylesheet" />

<div class="about-container">
    <div class="about-header">
        <h1>About Us</h1>
        <p class="subtitle">Your Trusted Mobile Recharge & Bill Payment Partner</p>
        <p>Connecting millions of users with instant, secure, and reliable mobile services since 2020</p>
    </div>

    <div class="about-content">
        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-bolt"></i>
            </div>
            <h3>Lightning Fast Recharge</h3>
            <p>Experience instant mobile recharges and bill payments with our optimized processing system that delivers results in seconds, not minutes.</p>
        </div>

        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3>Bank-Grade Security</h3>
            <p>Your transactions are protected with military-grade encryption and multi-layer security protocols ensuring complete peace of mind.</p>
        </div>

        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-users"></i>
            </div>
            <h3>24/7 Customer Support</h3>
            <p>Our dedicated support team is available round the clock to assist you with any queries or issues, ensuring seamless service experience.</p>
        </div>
    </div>

    <div class="section-block">
        <h2>Who We Are</h2>
        <p>
            We are a passionate team of technology enthusiasts committed to revolutionizing the way people manage their mobile services.
            Founded in 2020, our platform has processed over 2 million successful recharges and bill payments, serving customers across
            multiple regions with unparalleled reliability and speed.
        </p>
        <p>
            Our mission extends beyond just transactions - we're building a community where technology serves to simplify everyday life,
            making mobile management effortless and accessible to everyone, everywhere.
        </p>
    </div>

    <div class="section-block">
        <h2>Why Choose Recharge System?</h2>
        <ul class="why-list">
            <li><i class="ri-rocket-line"></i> Instant processing with 99.9% success rate</li>
            <li><i class="ri-lock-line"></i> Secure payment gateway with PCI DSS compliance</li>
            <li><i class="ri-customer-service-line"></i> 24/7 real-time customer support via chat, phone & email</li>
            <li><i class="ri-wifi-line"></i> Support for all major operators & service providers</li>
            <li><i class="ri-price-tag-line"></i> Best prices with exclusive offers and cashback rewards</li>
            <li><i class="ri-smartphone-line"></i> User-friendly interface optimized for all devices</li>
            <li><i class="ri-shield-check-line"></i> Transparent pricing with zero hidden charges</li>
            <li><i class="ri-flashlight-line"></i> Auto-detect number feature for faster recharges</li>
        </ul>
    </div>

    <div class="stats-section">
        <div class="stat-item">
            <h4>2M+</h4>
            <p>Successful Recharges</p>
        </div>
        <div class="stat-item">
            <h4>24/7</h4>
            <p>Service Availability</p>
        </div>
        <div class="stat-item">
            <h4>99.9%</h4>
            <p>Uptime Guarantee</p>
        </div>
        <div class="stat-item">
            <h4>50K+</h4>
            <p>Happy Customers</p>
        </div>
    </div>

    <!-- TEAM SECTION -->
    <div class="team-section">
        <h2>Meet Our Leadership Team</h2>
        <div class="team-grid">
            <div class="team-card">
                <h4>PHAM DOAN YEN HUONG</h4>
                <p>Founder & CEO</p>
                <small>Visionary leader driving innovation</small>
            </div>

            <div class="team-card">
                <h4>DANG MINH CHUONG</h4>
                <p>Product Manager</p>
                <small>Product strategy & user experience</small>
            </div>

            <div class="team-card">
                <h4>LY DUC XUAN</h4>
                <p>Lead Developer</p>
                <small>Technical architecture & innovation</small>
            </div>

            <div class="team-card">
                <h4>NGUYEN TRI DUNG</h4>
                <p>Customer Support Lead</p>
                <small>Customer satisfaction & support</small>
            </div>
        </div>
    </div>

    <div class="timeline-section">
        <h2>Our Growth Journey</h2>
        <div class="timeline">
            <div class="timeline-item">
                <span class="year">2020</span>
                <p>Launched platform with support for 3 major mobile operators, processing our first 1,000 recharges within first month.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2021</span>
                <p>Reached 10,000 active users milestone and integrated real-time payment gateway with enhanced security features.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2022</span>
                <p>Introduced 24/7 multilingual customer support and expanded services to 10 new regions across the country.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2023</span>
                <p>Achieved 50,000+ users with 99.9% system uptime and launched mobile app for iOS and Android platforms.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2024</span>
                <p>Launched AI-powered recharge optimization and predictive analytics for personalized user experiences.</p>
            </div>
        </div>
    </div>

    <div class="cta-section">
        <h2>Ready to Experience Seamless Recharge?</h2>
        <p>Join thousands of satisfied customers who trust us for their mobile recharge and bill payment needs.</p>
        <a href="/Recharge/Index" class="btn btn-primary btn-lg">
            <i class="fas fa-bolt me-2"></i>Start Recharging Now
        </a>
    </div>
</div>