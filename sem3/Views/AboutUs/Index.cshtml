﻿@{
    ViewBag.Title = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/about-us.css" rel="stylesheet" />

<div class="about-container">
    <div class="about-header">
        <h1>About Us</h1>
        <p class="subtitle">Your Trusted Mobile Recharge Partner</p>
    </div>
    <div class="about-content">
        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-bolt"></i>
            </div>
            <h3>Our Mission</h3>
            <p>To provide fast, secure, and convenient mobile recharge services that simplify your life and keep you connected always.</p>
        </div>

        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3>Our Vision</h3>
            <p>To become the most reliable and user-friendly mobile recharge platform, trusted by millions of users worldwide.</p>
        </div>

        <div class="about-card">
            <div class="icon-wrapper">
                <i class="fas fa-users"></i>
            </div>
            <h3>Our Values</h3>
            <p>Security, Speed, Reliability, and Customer Satisfaction are the core values that drive our services.</p>
        </div>
    </div>

    <div class="section-block">
        <h2>Who We Are</h2>
        <p>
            We are a dedicated team of developers, designers, and support specialists who are passionate about creating seamless digital experiences.
            Since 2020, our platform has helped users complete millions of mobile recharges quickly and securely.
        </p>
    </div>

    <div class="section-block">
        <h2>Why Choose Us?</h2>
        <ul class="why-list">
            <li><i class="fas fa-check-circle"></i> Instant recharge processing with zero delays.</li>
            <li><i class="fas fa-check-circle"></i> Secure payment system with advanced encryption.</li>
            <li><i class="fas fa-check-circle"></i> 24/7 real-time customer support.</li>
            <li><i class="fas fa-check-circle"></i> Coverage of all major mobile operators.</li>
            <li><i class="fas fa-check-circle"></i> Transparent pricing with no hidden fees.</li>
        </ul>
    </div>

    <div class="stats-section">
        <div class="stat-item">
            <h4>50,000+</h4>
            <p>Happy Customers</p>
        </div>
        <div class="stat-item">
            <h4>24/7</h4>
            <p>Service Available</p>
        </div>
        <div class="stat-item">
            <h4>99.9%</h4>
            <p>Uptime Guarantee</p>
        </div>
        <div class="stat-item">
            <h4>Instant</h4>
            <p>Recharge Processing</p>
        </div>
    </div>

    <!-- TEAM SECTION -->
    <div class="team-section">
        <h2>Meet Our Team</h2>
        <div class="team-grid">
            <div class="team-card">
                <h4>PHAM DOAN YEN HUONG</h4>
                <p>Founder & CEO</p>
            </div>

            <div class="team-card">
                <h4>DANG MINH CHUONG</h4>
                <p>Product Manager</p>
            </div>

            <div class="team-card">
                <h4>LY DUC XUAN</h4>
                <p>Lead Developer</p>
            </div>

            <div class="team-card">
                <h4>NGUYEN TRI DUNG</h4>
                <p>Customer Support Lead</p>
            </div>
        </div>
    </div>

    <div class="timeline-section">
        <h2>Our Journey</h2>
        <div class="timeline">
            <div class="timeline-item">
                <span class="year">2020</span>
                <p>Platform launched with support for 3 major mobile operators.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2021</span>
                <p>Reached 10,000 active users and added real-time payment gateway.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2022</span>
                <p>Introduced 24/7 customer support and expanded to 10 new regions.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2023</span>
                <p>Hit 50,000+ users milestone with 99.9% uptime stability.</p>
            </div>

            <div class="timeline-item">
                <span class="year">2024</span>
                <p>Launched AI-powered recharge optimization system.</p>
            </div>
        </div>
    </div>

    <div class="cta-section">
        <h2>Ready to Recharge?</h2>
        <p>Try our fast and secure mobile recharge service today.</p>
        <a href="/Recharge/Index" class="btn btn-primary btn-lg">Recharge Now</a>
    </div>

</div>