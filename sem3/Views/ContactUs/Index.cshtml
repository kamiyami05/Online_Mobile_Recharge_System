@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/contact-us.css" rel="stylesheet" />

<div class="contact-container">
    <div class="contact-header">
        <h1>Contact Us</h1>
        <p class="subtitle">Get in Touch with Our Mobile Recharge Center</p>
    </div>

    <div class="contact-content">
        <div class="contact-info">
            <div class="contact-card">
                <div class="contact-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="contact-details">
                    <h3>Visit Our Office</h3>
                    <p>@Html.Raw(ViewBag.Address)</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <div class="contact-details">
                    <h3>Call Us</h3>
                    <p>Main: @ViewBag.PhoneMain<br>Support: @ViewBag.PhoneSupport</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div class="contact-details">
                    <h3>Email Us</h3>
                    <p>@ViewBag.Email1<br>@ViewBag.Email2</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="contact-details">
                    <h3>Business Hours</h3>
                    <p>Monday - Friday: @ViewBag.HoursWeekdays<br>Saturday - Sunday: @ViewBag.HoursWeekend</p>
                </div>
            </div>
        </div>

        <div class="contact-form">
            <h3>Send Us a Message</h3>
            <form>
                <div class="form-group">
                    <input type="text" placeholder="Your Name" required>
                </div>
                <div class="form-group">
                    <input type="email" placeholder="Your Email" required>
                </div>
                <div class="form-group">
                    <textarea placeholder="Your Message" rows="5" required></textarea>
                </div>
                <button type="submit" class="submit-btn">Send Message</button>
            </form>
        </div>
    </div>
</div>