@{
    ViewBag.Title = "Payment Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/payment.css" rel="stylesheet" />

<div class="success-container">
    <div class="success-card" id="invoice-content">
        <div class="success-header">
            <h1><i class="fas fa-check-circle"></i> Payment Successful!</h1>
            <p>Thank you for using our service</p>
        </div>

        <div class="success-body">
            <div class="invoice">
                <h4>ELECTRONIC RECEIPT</h4>
                <div class="invoice-details">
                    <div class="invoice-row">
                        <span class="invoice-label">Transaction ID:</span>
                        <span class="invoice-value">@ViewBag.TransactionId</span>
                    </div>
                    <div class="invoice-row">
                        <span class="invoice-label">Date & Time:</span>
                        <span class="invoice-value">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="invoice-row">
                        <span class="invoice-label">Phone Number:</span>
                        <span class="invoice-value">@ViewBag.Phone</span>
                    </div>
                    <div class="invoice-row">
                        <span class="invoice-label">Operator:</span>
                        <span class="invoice-value">@ViewBag.Operator</span>
                    </div>
                    <div class="invoice-row">
                        <span class="invoice-label">Plan:</span>
                        <span class="invoice-value">@ViewBag.PlanName</span>
                    </div>
                    <div class="invoice-row">
                        <span class="invoice-label">Total Amount:</span>
                        <span class="invoice-value invoice-total">@string.Format("{0:n0}", ViewBag.Amount) VND</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="success-footer">
            Online Recharge System - Thank you for your business!
        </div>
    </div>

    <div class="action-buttons no-print">
        <button onclick="window.print()" class="btn-print">
            <i class="fas fa-print"></i> Print Receipt
        </button>
        <a href="@Url.Action("Index", "Recharge")" class="btn-home">
            <i class="fas fa-home"></i> Back to Home
        </a>
    </div>
</div>