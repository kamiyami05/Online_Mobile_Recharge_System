@{
    Layout = null;
}

<div class="payment-form-container">
    <div class="payment-form-header">
        <h4><i class="fas fa-lock"></i> Secure Payment - @ViewBag.Method</h4>
    </div>
    <div class="payment-form-body">
        <div class="payment-info">
            <p>You are making a payment for: <strong class="payment-plan">@ViewBag.PlanName</strong></p>
            <p>Total Amount: <strong class="payment-amount">@string.Format("{0:n0}", ViewBag.Amount) VND</strong></p>
        </div>

        @if (ViewBag.Method == "Visa")
        {
            <div class="demo-info">
                <strong><i class="fas fa-info-circle"></i> Demo Card Information:</strong>
                <div class="demo-card demo-success">
                    ✅ Successful Payment: 4222 2222 2222 2222
                </div>
                <div class="demo-card demo-failed">
                    ❌ Insufficient Funds: 4000 0000 0000 0000
                </div>
            </div>
        }

        <form action="@Url.Action("ConfirmPayment", "Recharge")" method="post" class="payment-form">
            <input type="hidden" name="method" value="@ViewBag.Method" />
            <input type="hidden" name="phone" value="@ViewBag.Phone" />
            <input type="hidden" name="operatorName" value="@ViewBag.Operator" />
            <input type="hidden" name="planName" value="@ViewBag.PlanName" />
            <input type="hidden" name="amount" value="@ViewBag.Amount" />
            <input type="hidden" name="planId" value="@ViewBag.PlanId" />

            @if (ViewBag.Method == "Visa")
            {
                <div class="form-group">
                    <label for="txtCardNumber">Card Number</label>
                    <input type="text" id="txtCardNumber" name="cardNumber" class="form-control"
                           placeholder="xxxx xxxx xxxx" maxlength="19" required />
                </div>

                <div class="form-group">
                    <label for="txtCardName">Name on Card</label>
                    <input type="text" id="txtCardName" name="cardName" class="form-control"
                           placeholder="Your name" required />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="txtExpiry">Expiry Date</label>
                        <input type="text" id="txtExpiry" name="expiryDate" class="form-control"
                               placeholder="MM/YY" maxlength="5" required />
                    </div>
                    <div class="form-group">
                        <label for="txtCVV">CVV</label>
                        <input type="text" id="txtCVV" name="cvv" class="form-control"
                               placeholder="123" maxlength="3" required />
                    </div>
                </div>
            }

            <button type="submit" class="btn-pay">
                <i class="fas fa-lock"></i> Pay @string.Format("{0:n0}", ViewBag.Amount) VND
            </button>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Format card number with spaces
        $('#txtCardNumber').on('input', function () {
            var value = $(this).val().replace(/\D/g, '').substring(0, 16);
            var formattedValue = value != '' ? value.match(/.{1,4}/g).join(' ') : '';
            $(this).val(formattedValue);
        });

        // Format expiry date
        $('#txtExpiry').on('input', function () {
            var value = $(this).val().replace(/\D/g, '').substring(0, 4);
            if (value.length >= 3) {
                $(this).val(value.substring(0, 2) + '/' + value.substring(2, 4));
            } else {
                $(this).val(value);
            }
        });

        // Only numbers for CVV
        $('#txtCVV').on('input', function () {
            $(this).val($(this).val().replace(/\D/g, ''));
        });
    });
</script>