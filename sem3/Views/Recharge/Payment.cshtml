@using sem3.Models.Entities
@{
    ViewBag.Title = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var plan = ViewBag.Plan as RechargePlan;
}

<link href="~/Content/Client/payment.css" rel="stylesheet" />

<div class="payment-container">
    <div class="payment-header">
        <h1>Payment Options</h1>
        <p>Complete your recharge by selecting a payment method</p>
    </div>

    <!-- Order Summary -->
    <div class="order-summary">
        <h3><i class="fas fa-receipt"></i> Order Summary</h3>
        <div class="order-details">
            <div class="detail-item">
                <span class="detail-label">Phone Number</span>
                <span class="detail-value">@ViewBag.Phone</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Operator</span>
                <span class="detail-value">@ViewBag.Operator</span>
            </div>
            @if (plan != null)
            {
                <div class="detail-item">
                    <span class="detail-label">Selected Plan</span>
                    <span class="detail-value">@plan.PlanType</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Total Amount</span>
                    <span class="detail-value amount-highlight">@string.Format("{0:n0}", plan.Amount) VND</span>
                </div>
            }
        </div>
    </div>

    <input type="hidden" id="hdnPlanId" value="@(plan != null ? plan.PlanID : 0)" />
    <input type="hidden" id="hdnPhone" value="@ViewBag.Phone" />
    <input type="hidden" id="hdnOperator" value="@ViewBag.Operator" />
    <input type="hidden" id="hdnPlanName" value="@(plan != null ? plan.PlanType : "")" />
    <input type="hidden" id="hdnAmount" value="@(plan != null ? plan.Amount : 0)" />

    <!-- Payment Methods -->
    <div class="payment-methods-section">
        <h3><i class="fas fa-credit-card"></i> Choose Payment Method</h3>
        <div class="payment-methods-grid">
            <button class="payment-method-btn" data-method="Visa">
                <div class="method-icon">💳</div>
                <div class="method-name">Visa Card</div>
            </button>
        </div>
    </div>

    <!-- Payment Form Area -->
    <div id="paymentArea"></div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $(".payment-method-btn").click(function () {
            // Remove active class from all buttons
            $(".payment-method-btn").removeClass("active");
            // Add active class to clicked button
            $(this).addClass("active");

            var method = $(this).data("method");

            $("#paymentArea").html(`
                <div class="loading-spinner" style="text-align: center; padding: 20px;">
                    <i class="fas fa-spinner fa-spin"></i> Loading payment form...
                </div>
            `);

            $.ajax({
                url: '/Recharge/LoadPaymentForm',
                type: 'GET',
                data: {
                    method: method,
                    planId: $("#hdnPlanId").val(),
                    phone: $("#hdnPhone").val(),
                    operatorName: $("#hdnOperator").val(),
                    planName: $("#hdnPlanName").val(),
                    amount: $("#hdnAmount").val()
                },
                success: function (response) {
                    $("#paymentArea").html(response);
                },
                error: function (xhr, status, error) {
                    console.error(error);
                    $("#paymentArea").html(`
                        <div class="error-message">
                            <strong><i class="fas fa-exclamation-triangle"></i> Error</strong>
                            <p>Failed to load payment form: ${error}</p>
                        </div>
                    `);
                }
            });
        });
    });
</script>