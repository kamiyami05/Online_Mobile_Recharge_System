@{
    ViewBag.Title = "Payment Failed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Client/payment.css" rel="stylesheet" />

<div class="failed-container">
    <div class="failed-card">
        <div class="failed-header">
            <h1><i class="fas fa-times-circle"></i> Payment Failed</h1>
            <p>We couldn't process your transaction</p>
        </div>

        <div class="failed-body">
            <div class="error-message">
                <strong><i class="fas fa-exclamation-triangle"></i> Reason:</strong>
                <p>@ViewBag.ErrorMessage</p>
            </div>

            <p>Please check your card information or account balance and try again.</p>

            <div class="retry-buttons">
                <a href="@Url.Action("TopUp", "Recharge")" class="btn-retry btn-pay">
                    <i class="fas fa-redo"></i> Try Again
                </a>
                <a href="@Url.Action("Index", "Recharge")" class="btn-home">
                    <i class="fas fa-home"></i> Back to Home
                </a>
            </div>
        </div>

        <div class="success-footer">
            Need assistance? Please contact customer support: 1900-XXXX
        </div>
    </div>
</div>