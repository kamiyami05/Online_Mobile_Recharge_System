@{
    ViewBag.Title = "Thanh toán thất bại";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card text-center border-danger">
        <div class="card-header bg-danger text-white">
            <h2><i class="fa fa-times-circle"></i> Failed payment!</h2>
        </div>
        <div class="card-body">
            <h5 class="card-title text-danger">Rất tiếc, giao dịch không thể thực hiện</h5>

            <div class="alert alert-warning mt-3" role="alert">
                <strong>Reason:</strong> @ViewBag.ErrorMessage
            </div>

            <p class="card-text mt-3">
                Vui lòng kiểm tra lại thông tin thẻ hoặc số dư tài khoản của bạn.
            </p>

            <hr />

            <div class="mt-4">
                <a href="@Url.Action("TopUp", "Recharge")" class="btn btn-warning btn-lg">
                    <i class="fa fa-refresh"></i> Try Again
                </a>

                <a href="@Url.Action("Index", "Recharge")" class="btn btn-secondary btn-lg ml-2">
                    Home
                </a>
            </div>
        </div>
        <div class="card-footer text-muted">
            Nếu bạn cần hỗ trợ, vui lòng liên hệ CSKH: 1900 xxxx
        </div>
    </div>
</div>