@model List<sem3.Models.Entities.User>

    @{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>User Management</h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Filter Options</h6>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="fw-bold">Filter by Status:</label>
                    <select id="statusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="userTable" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Status / Action</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                        foreach (var user in Model)
                        {
                        <tr>
                            <td>@user.UserID</td>
                            <td>@user.FullName</td>
                            <td>@user.MobileNumber</td>
                            <td>@user.Email</td>
                            <td>@user.Address</td>

                            <td class="text-center" data-status="@(user.Active == true ? " true" : "false" )">
                                @if (user.Active == true)
                                {
                                <button type="button" class="btn btn-success btn-sm toggle-btn" style="width: 100px" data-id="@user.UserID" data-status="false">
                                    <i class="fas fa-check-circle"></i> Active
                                </button>
                                }
                                else
                                {
                                <button type="button" class="btn btn-secondary btn-sm toggle-btn" style="width: 100px" data-id="@user.UserID" data-status="true">
                                    <i class="fas fa-times-circle"></i> Inactive
                                </button>
                                }
                            </td>

                            <td data-order="@(user.RegistrationDate.HasValue ? user.RegistrationDate.Value.Ticks : 0)">
                                @(user.RegistrationDate.HasValue ? user.RegistrationDate.Value.ToString("yyyy-MM-dd HH:mm") : "")
                            </td>
                        </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section myscript {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {

            // --- 1. LOGIC BỘ LỌC STATUS ---
            $.fn.dataTable.ext.search.push(
                function (settings, data, dataIndex) {
                    var statusFilter = $('#statusFilter').val();

                    // Lấy dòng hiện tại (DOM node)
                    var rowNode = settings.aoData[dataIndex].nTr;

                    // Tìm giá trị data-status trong cột (cột active/deactive)
                    // Lưu ý: convert sang string để so sánh an toàn
                    var statusValue = $(rowNode).find('td[data-status]').data('status').toString();

                    // Nếu không chọn filter (rỗng) hoặc giá trị khớp nhau thì hiển thị
                    if (statusFilter === "" || statusValue === statusFilter) {
                        return true;
                    }
                    return false;
                }
            );

            // --- 2. KHỞI TẠO DATATABLE ---
            var table = $('#userTable').DataTable({
                "paging": true,
                "pagingType": "full_numbers",
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "order": [[0, "desc"]], // Sắp xếp ID giảm dần
                "columnDefs": [
                    {
                        "targets": [0], // Ẩn cột ID đi cho gọn (nếu muốn hiện thì xóa dòng này)
                        "visible": false,
                        "searchable": false
                    }
                ]
            });

            // --- 3. SỰ KIỆN KHI CHỌN DROPDOWN ---
            $('#statusFilter').change(function () {
                table.draw(); // Vẽ lại bảng để áp dụng bộ lọc
            });

            // --- 4. XỬ LÝ NÚT ACTIVE/DEACTIVE ---
            $(document).on('click', '.toggle-btn', function () {
                var btn = $(this);
                var id = btn.data('id');
                var newStatus = btn.data('status'); // true hoặc false
                var actionName = newStatus ? "Activate" : "Deactivate";

                if (confirm('Are you sure you want to ' + actionName + ' this user?')) {
                    $.ajax({
                        url: '@Url.Action("UpdateStatus", "Usermgmt", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: id, status: newStatus },
                        success: function (response) {
                            if (response.success) {
                                location.reload(); // Tải lại trang để cập nhật giao diện
                            } else {
                                alert('Update failed: ' + response.message);
                            }
                        },
                        error: function (xhr, status, error) {
                            alert('Error: ' + error);
                        }
                    });
                }
            });
        });
    </script>
    }
