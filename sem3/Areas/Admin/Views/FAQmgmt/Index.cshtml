@model List<sem3.Models.Entities.FAQ>
@{ Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; }

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>FAQ Management</h1>
    <a href="@Url.Action("Create", "FAQmgmt")" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Question</a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Filter Options</h6>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="fw-bold">Filter by Status:</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="faqTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 25%;">Question</th>
                        <th style="width: 45%;">Answer</th>
                        <th style="width: 15%;">Status</th>
                        <th style="width: 15%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="white-space: normal;">@item.Question</td>

                                <td style="white-space: normal; word-wrap: break-word; max-width: 400px;">
                                    @item.Answer
                                </td>

                                <td class="text-center" data-status="@(item.IsActive == true ? "true" : "false")">
                                    @if (item.IsActive == true)
                                    {
                                        <button type="button" class="btn btn-success btn-sm toggle-btn" style="width: 80px" data-id="@item.FAQID" data-status="false">Active</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm toggle-btn" style="width: 80px" data-id="@item.FAQID" data-status="true">Inactive</button>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "FAQmgmt", new { id = item.FAQID })" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                    <button type="button" class="btn btn-danger btn-sm delete-btn" data-id="@item.FAQID"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section myscript {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {

            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var statusFilter = $('#statusFilter').val();
                    var rowNode = settings.aoData[dataIndex].nTr;
                    var statusValue = $(rowNode).find('td[data-status]').data('status').toString();

                    if (statusFilter === "" || statusValue === statusFilter) {
                        return true;
                    }
                    return false;
                }
            );

            var table = $('#faqTable').DataTable({
                "dom": 'lrtip',
                "order": [],
                "autoWidth": false,
                "columnDefs": [
                   { "targets": [3], "orderable": false }
                ]
            });

            $('#statusFilter').change(function() {
                table.draw();
            });

            $(document).on('click', '.toggle-btn', function () {
                var btn = $(this);
                var id = btn.data('id');
                var newStatus = btn.data('status');

                $.ajax({
                    url: '@Url.Action("UpdateStatus", "FAQmgmt")',
                    type: 'POST',
                    data: { id: id, status: newStatus },
                    success: function (res) {
                        if (res.success) location.reload();
                        else alert('Update failed: ' + res.message);
                    }
                });
            });

            $(document).on('click', '.delete-btn', function () {
                if (confirm('Delete this question?')) {
                    var id = $(this).data('id');
                    var $row = $(this).closest('tr');
                    $.ajax({
                        url: '@Url.Action("Delete", "FAQmgmt")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) table.row($row).remove().draw();
                            else alert('Delete failed: ' + res.message);
                        }
                    });
                }
            });
        });
    </script>
}