@model List<sem3.Models.Entities.Transaction>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Transaction Management</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Transaction History</h6>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="fw-bold">Status:</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All</option>
                    <option value="Success">Success</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="fw-bold">Type:</label>
                <select id="typeFilter" class="form-select">
                    <option value="">All</option>
                    <option value="Recharge">Recharge</option>
                    <option value="Wallet Top-up">Wallet Top-up</option>
                    <option value="Postpaid Bill Payment">Postpaid Bill Payment</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="transTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>User Info</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var payDetail = item.PaymentDetails != null ? item.PaymentDetails.FirstOrDefault() : null;
                            var script = item.TransactionScripts != null ? item.TransactionScripts.FirstOrDefault() : null;

                            <tr>
                                <td>@item.TransactionID</td>
                                <td>
                                    @if (item.User != null)
                                    {<strong>@item.User.FullName</strong><br /><small>@item.MobileNumber</small> }
                                else
                                { <strong>Guest</strong><br /><small>@item.MobileNumber</small>}
                                </td>
                                <td data-type="@item.TransactionType">
                                    @if (item.TransactionType == "Recharge")
                                    {<span class="badge bg-info text-dark">Recharge</span> }
                                    else if (item.TransactionType == "Wallet Top-up")
                                    { <span class="badge bg-primary">Top-up</span> }
                                    else
                                    { <span class="badge bg-secondary">Bill</span>}
                                </td>
                                <td class="text-end">@item.Amount.ToString("N0")</td>
                                <td class="text-center" data-status="@item.Status">
                                    @if (item.Status == "Success")
                                    {<span class="badge bg-success">Success</span> }
                                    else if (item.Status == "Pending")
                                    { <span class="badge bg-warning text-dark">Pending</span> }
                                    else if (item.Status == "Cancelled")
                                    { <span class="badge bg-dark">Cancelled</span> }
                                    else
                                    { <span class="badge bg-danger">Failed</span>}
                                </td>
                                <td data-order="@(item.TransactionDate.HasValue ? item.TransactionDate.Value.Ticks : 0)">
                                    @(item.TransactionDate.HasValue ? item.TransactionDate.Value.ToString("yyyy-MM-dd HH:mm") : "")
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-info btn-sm view-btn"
                                            data-bs-toggle="modal" data-bs-target="#detailModal"
                                            data-id="@item.TransactionID"
                                            data-method="@(payDetail != null ? payDetail.PaymentMethod : "N/A")"
                                            data-ref="@(payDetail != null ? payDetail.ReferenceNumber : "N/A")"
                                            data-script="@(script != null ? script.ScriptContent : "No logs available")">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Transaction Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary">Payment Info</h6>
                        <table class="table table-bordered">
                            <tr><th class="bg-light">ID</th><td id="modalId"></td></tr>
                            <tr><th class="bg-light">Method</th><td id="modalMethod"></td></tr>
                            <tr><th class="bg-light">Reference</th><td id="modalRef" class="fw-bold text-danger"></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-secondary">System Log</h6>
                        <div class="bg-dark text-white p-3 rounded" style="height: 150px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                            <code id="modalScript" style="color: #00ff41;"></code>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section myscript {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var statusFilter = $('#statusFilter').val();
                var typeFilter = $('#typeFilter').val();
                var rowNode = settings.aoData[dataIndex].nTr;
                var statusValue = $(rowNode).find('td[data-status]').data('status');
                var typeValue = $(rowNode).find('td[data-type]').data('type');
                var statusMatch = (statusFilter === "") || (statusValue == statusFilter);
                var typeMatch = (typeFilter === "") || (typeValue == typeFilter);
                return statusMatch && typeMatch;
            });

            var table = $('#transTable').DataTable({
                "paging": true,
                "pagingType": "full_numbers",
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "order": [[0, "desc"]],
                "columnDefs": [{ "targets": [6], "orderable": false, "searchable": false }]
            });

            $('#statusFilter, #typeFilter').change(function () { table.draw(); });
            $(document).on('click', '.view-btn', function () {
                var btn = $(this);
                $('#modalId').text('#' + btn.data('id'));
                $('#modalMethod').text(btn.data('method'));
                $('#modalRef').text(btn.data('ref'));
                $('#modalScript').text(btn.data('script'));
            });
        });
    </script>
}