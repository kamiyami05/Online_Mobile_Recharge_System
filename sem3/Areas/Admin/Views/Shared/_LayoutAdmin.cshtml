<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Admin - Dashboard</title>

    <link href="@Url.Content("~/content/admin")/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="@Url.Content("~/content/admin")/css/sb-admin-2.min.css" rel="stylesheet">
    <style>
        html, body {
            height: 100vh !important;
            overflow: hidden !important;
            margin: 0 !important;
        }
        #wrapper {
            height: 100vh !important;
            overflow: hidden !important;
            display: flex !important;
        }
        ul.sidebar {
            height: 100vh !important;
            overflow-y: auto !important;
            flex-shrink: 0 !important;
        }
            ul.sidebar::-webkit-scrollbar {
                width: 0px;
                background: transparent;
            }
        #content-wrapper {
            height: 100vh !important;
            overflow-y: auto !important;
            width: 100% !important;
            position: relative !important;
        }
    </style>
</head>
<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-laugh-wink"></i>
                </div>
                <div class="sidebar-brand-text mx-3">Admin</div>
            </a>
            <hr class="sidebar-divider my-0">
            <hr class="sidebar-divider">
            <hr class="sidebar-divider">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("index", "Usermgmt", new { area = "Admin" })">
                    <i class="fas fa-user-cog"></i>
                    <span>User Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("index", "Feedbackmgmt", new { area = "Admin" })">
                    <i class="fas fa-user-cog"></i>
                    <span>Feedback Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("index", "Transactionmgmt", new { area = "Admin" })">
                    <i class="fas fa-user-cog"></i>
                    <span>Transaction Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("index", "Planmgmt", new { area = "Admin" })">
                    <i class="fas fa-user-cog"></i>
                    <span>Plan Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Logout", "Login", new { area = "" })" style="color:red">
                    <i class="fas fa-sign-out-alt" style="color:red"></i>
                    <span>Logout</span>
                </a>
            </li>
            <hr class="sidebar-divider d-none d-md-block">
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
            <div class="sidebar-card d-none d-lg-flex">
                <img class="sidebar-card-illustration mb-2" src="@Url.Content("~/content/admin")/img/undraw_rocket.svg" alt="...">
                <a class="btn btn-success btn-sm" href="https://www.facebook.com/dxuan1912">Contact Me</a>
            </div>
        </ul>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <div class="container-fluid">
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">@ViewBag.Title</h1>
                    </div>
                    @RenderBody()
                </div>
            </div>
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright © dxuan</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="@Url.Content("~/content/admin")/vendor/jquery/jquery.min.js"></script>
    <script src="@Url.Content("~/content/admin")/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/content/admin")/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="@Url.Content("~/content/admin")/js/sb-admin-2.min.js"></script>
    <script src="@Url.Content("~/content/admin")/vendor/chart.js/Chart.min.js"></script>
    <script src="@Url.Content("~/content/admin")/js/demo/chart-area-demo.js"></script>
    <script src="@Url.Content("~/content/admin")/js/demo/chart-pie-demo.js"></script>

    @RenderSection("myscript", required: false)
</body>
</html>