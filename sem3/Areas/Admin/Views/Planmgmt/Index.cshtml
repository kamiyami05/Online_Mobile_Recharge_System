@model List<sem3.Models.Entities.RechargePlan>

@{ Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; }

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Plan Management</h1>
    <a href="@Url.Action("Create", "Planmgmt")" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Plan</a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Filter Options</h6></div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3 mb-2">
                <label class="fw-bold">Search Name:</label>
                <input type="text" id="nameSearch" class="form-control" placeholder="Enter plan name...">
            </div>

            <div class="col-md-2 mb-2">
                <label class="fw-bold">Operator:</label>
                <select id="operatorFilter" class="form-select">
                    <option value="">All Operators</option>
                    <option value="Viettel">Viettel</option>
                    <option value="Vinaphone">Vinaphone</option>
                    <option value="Mobiphone">Mobiphone</option>
                    <option value="Vietnamobile">Vietnamobile</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <label class="fw-bold">Type:</label>
                <select id="typeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Data">Data</option>
                    <option value="Prepaid">Prepaid</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <label class="fw-bold">Status:</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <label class="fw-bold">Price Range:</label>
                <div class="input-group">
                    <input type="number" id="minPrice" class="form-control" placeholder="Min">
                    <span class="input-group-text">-</span>
                    <input type="number" id="maxPrice" class="form-control" placeholder="Max">
                </div>
            </div>
        </div>
        <hr />

        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="planTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Plan Name</th>
                        <th>Operator</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Benefits</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PlanID</td>
                                <td class="fw-bold text-primary">@item.PlanName</td>
                                <td data-operator="@item.Operator">@item.Operator</td>
                                <td data-type="@item.PlanType">
                                    @if (item.PlanType == "Data")
                                    {<span class="badge bg-info text-dark">Data</span> }
                                    else
                                    { <span class="badge bg-secondary">Prepaid</span>}
                                </td>
                                <td class="text-end" data-amount="@item.Amount">@item.Amount.ToString("N0")</td>
                                <td>
                                    <small>
                                        @if (item.DataMB > 0)
                                        {<span><i class="fas fa-wifi"></i> @item.DataMB MB</span><br />}
                                        @if (item.TalkTimeMinutes > 0)
                                        {<span><i class="fas fa-phone"></i> @item.TalkTimeMinutes mins</span><br />}
                                        <span class="text-muted">@item.Details</span>
                                    </small>
                                </td>
                                <td class="text-center" data-status="@(item.IsActive == true ? "true" : "false")">
                                    @if (item.IsActive == true)
                                    {
                                        <button type="button" class="btn btn-success btn-sm toggle-btn" style="width: 80px" data-id="@item.PlanID" data-status="false">Active</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm toggle-btn" style="width: 80px" data-id="@item.PlanID" data-status="true">Inactive</button>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Planmgmt", new { id = item.PlanID })" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                    <button type="button" class="btn btn-danger btn-sm delete-btn" data-id="@item.PlanID"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section myscript {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            // Bộ lọc tùy chỉnh
            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                var opFilter = $('#operatorFilter').val();
                var typeFilter = $('#typeFilter').val();
                var statusFilter = $('#statusFilter').val();
                var minPrice = parseFloat($('#minPrice').val()) || 0;
                var maxPrice = parseFloat($('#maxPrice').val()) || 999999999;

                var rowNode = settings.aoData[dataIndex].nTr;
                var opValue = $(rowNode).find('td[data-operator]').data('operator');
                var typeValue = $(rowNode).find('td[data-type]').data('type');
                var statusValue = $(rowNode).find('td[data-status]').data('status').toString();
                var amountValue = parseFloat($(rowNode).find('td[data-amount]').data('amount')) || 0;

                var opMatch = (opFilter === "") || (opValue === opFilter);
                var typeMatch = (typeFilter === "") || (typeValue === typeFilter);
                var statusMatch = (statusFilter === "") || (statusValue === statusFilter);
                var priceMatch = (amountValue >= minPrice && amountValue <= maxPrice);

                return opMatch && typeMatch && statusMatch && priceMatch;
            });

            var table = $('#planTable').DataTable({
                "dom": 'lrtip', // Ẩn ô search mặc định
                "order": [[0, "desc"]],
                "columnDefs": [ { "targets": [7], "orderable": false } ]
            });

            // Sự kiện lọc
            $('#operatorFilter, #typeFilter, #statusFilter, #minPrice, #maxPrice').on('change keyup', function() {
                table.draw();
            });

            // Tìm kiếm theo tên (ô input mới)
            $('#nameSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Nút Active/Deactive
            $(document).on('click', '.toggle-btn', function () {
                var btn = $(this);
                var id = btn.data('id');
                var newStatus = btn.data('status');
                var actionName = newStatus ? "Activate" : "Deactivate";
                if (confirm('Are you sure you want to ' + actionName + ' this plan?')) {
                    $.ajax({
                        url: '@Url.Action("UpdateStatus", "Planmgmt")',
                        type: 'POST',
                        data: { id: id, status: newStatus },
                        success: function (res) {
                            if (res.success) location.reload();
                            else alert('Update failed: ' + res.message);
                        },
                        error: function () { alert('Error connecting to server'); }
                    });
                }
            });

            // Nút Delete
            $(document).on('click', '.delete-btn', function () {
                if (confirm('Are you sure you want to delete this plan?')) {
                    var id = $(this).data('id');
                    var $row = $(this).closest('tr');
                    $.ajax({
                        url: '@Url.Action("Delete", "Planmgmt")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) table.row($row).remove().draw();
                            else alert(res.message);
                        }
                    });
                }
            });
        });
    </script>
}